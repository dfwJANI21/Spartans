# ==============================================================================
# Omni-Teach Live - Environment Variables
# ==============================================================================

# [REQUIRED FOR LIVE GEMINI CALLS & WEBSOCKETS]
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# [SERVER CONFIGURATION]
# Comma-separated list of origins allowed for CORS (leave empty for same-origin only)
ALLOWED_ORIGINS=
# LOCAL DEMO ONLY: sends GEMINI_API_KEY to the browser so the Live voice tutor can connect directly.
# Never enable on a public deployment.
ALLOW_CLIENT_KEY=false
PORT=3000
NODE_ENV=development

# [FIREBASE FIRESTORE INTEGRATION]
# Optional: If omitted, Omni-Teach Live runs with in-memory resilient cache
FIREBASE_PROJECT_ID=
# Path to serviceAccount.json file OR raw JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=

# [GOOGLE WORKSPACE ORCHESTRATION (Drive, Docs, Forms)]
# Optional: Service account credentials for creating real Google Docs, Forms, and Drive folders
# If omitted, Omni-Teach Live generates full preview and simulated workspace links
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
